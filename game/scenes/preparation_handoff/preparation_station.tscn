[sub_resource type="Shader" id="Shader_remove_gray"]
code = "shader_type canvas_item;
void fragment() {
 vec4 c = texture(TEXTURE, UV);
 vec3 matte = vec3(245.0 / 255.0);
 float edge_alpha = smoothstep(0.025, 0.18, length(c.rgb - matte));
 c.rgb = clamp((c.rgb - matte * (1.0 - edge_alpha)) / max(edge_alpha, 0.001), vec3(0.0), vec3(1.0));
 c.a *= edge_alpha;
 COLOR = c;
}"

[sub_resource type="ShaderMaterial" id="Material_food"]
shader = SubResource("Shader_remove_gray")

